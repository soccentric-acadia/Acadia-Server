{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "acadia-server",
    "version": "0.1.0",
    "dependencies": [
        {
            "name": "grpc",
            "features": [
                "codegen"
            ]
        },
        "protobuf",
        {
            "name": "drogon",
            "features": [
                "postgres",
                "orm"
            ]
        },
        "spdlog",
        "yaml-cpp",
        "prometheus-cpp",
        {
            "name": "gtest"
        },
        "libargon2",
        "nlohmann-json",
        "openssl",
        "zlib",
        "jsoncpp"
    ],
    "builtin-baseline": "2024.10.21",
    "overrides": []
}